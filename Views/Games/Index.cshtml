@model List<WellmanFinal1.Models.Game>

@{
    ViewData["Title"] = "My Games";
}

<h1>My Favorite Games</h1>
<p>Below is a list of games stored in my SQL Server database.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Genre</th>
            <th>Rating</th>
            <th>Hours Played</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var game in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@game.Id">
                        @game.Name
                    </a>
                </td>
                <td>@game.Genre</td>
                <td>@game.Rating</td>
                <td>@game.HoursPlayed</td>
            </tr>
        }
    </tbody>
</table>