@model List<WellmanFinal1.Models.Game>

@{
    ViewData["Title"] = "My Games";
}

<h1>My Favorite Games (From Database)</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Genre</th>
            <th>Rating</th>
            <th>Hours Played</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var game in Model)
        {
            <tr>
                <td>@game.Name</td>
                <td>@game.Genre</td>
                <td>@game.Rating</td>
                <td>@game.HoursPlayed</td>
            </tr>
        }
    </tbody>
</table>