@model WellmanFinal1.Models.Game

@{
    ViewData["Title"] = "Game Details";
}

<h1>@Model.Name</h1>

<hr />

<p><strong>Genre:</strong> @Model.Genre</p>
<p><strong>Rating:</strong> @Model.Rating / 10</p>
<p><strong>Hours Played:</strong> @Model.HoursPlayed</p>

<hr />

<img src="@Model.ImagePath"
     style="width:300px;" />